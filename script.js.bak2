      {label:"Evitar",body:"<ul><li>Pulseira</li><li>Metal aterrado</li><li>Evitar sintéticos</li><li>Segurar pelas bordas</li></ul>"}
    ]},
    {ico:"✓",name:"Inspeção",sections:[
